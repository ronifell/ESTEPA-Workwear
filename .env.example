# ESTEPA Workwear — environment variables
# Copy to `.env.local` and fill in the values you actually have.
# Every variable is optional: the site runs with all of them unset.

# Absolute site URL. Used for canonical URLs, hreflang, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Contact details
# Leave empty until the real values exist — the UI hides whatever is missing
# instead of rendering a fake placeholder.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Digits only, international format, no "+" (e.g. 5492641234567)
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_ADDRESS=

# ---------------------------------------------------------------------------
# Social profiles — only real profiles should be listed.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_FACEBOOK=

# ---------------------------------------------------------------------------
# Commerce
# ---------------------------------------------------------------------------
# Set to "true" once the catalogue has confirmed prices. While it is false the
# storefront collects quotation requests and shows "price to be confirmed"
# instead of inventing amounts.
NEXT_PUBLIC_PRICES_ENABLED=false

# Public path or URL of the downloadable catalogue (e.g. /catalogo-estepa.pdf).
# The download CTA stays disabled while this is empty.
NEXT_PUBLIC_CATALOG_PDF_URL=

# ---------------------------------------------------------------------------
# Database (optional)
# Unset: leads and orders are appended to ./.data/*.ndjson.
# Set:    leads and orders are stored in PostgreSQL through Prisma.
#         Run `npm run db:push` (and `npm run db:seed` for the catalogue).
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/estepa
